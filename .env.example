# ==============================================================================
# ALTA - Environment Configuration Template
# Real Backend Services & API Credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Row-Level Security & Edge Functions)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Server-Side AI / LLM Provider (Gemini / Anthropic / OpenAI)
# Used for diagnostic questioning, weakness detection, task generation & progressive hints
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...
# Or:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ------------------------------------------------------------------------------
# 3. Judge0 CE (Secure Isolated Sandbox Code Execution)
# Never exposes hidden tests or execution keys to client frontend
# ------------------------------------------------------------------------------
JUDGE0_API_HOST=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-key-here
JUDGE0_CPU_TIME_LIMIT=2.0
JUDGE0_MEMORY_LIMIT=128000

# ------------------------------------------------------------------------------
# 4. ALTA Security & Certificates
# ------------------------------------------------------------------------------
CERTIFICATE_SIGNING_SECRET=your-cryptographic-sha256-salt-key-here
ALTA_ENVIRONMENT=production
